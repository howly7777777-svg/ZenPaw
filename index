        function switchLanguage(lang) {
            const t = translations[lang] || translations["en"];
            document.documentElement.lang = lang;
            
            document.getElementById("heroTitle").textContent = t.heroTitle;
            document.getElementById("heroSubtitle").textContent = t.heroSubtitle;
            document.getElementById("btnDownload").textContent = t.btnDownload;
            document.getElementById("btnPrivacy").textContent = t.btnPrivacy;
            document.getElementById("btnLearnPrivacy").textContent = t.btnLearnPrivacy;
            document.getElementById("linkFooterPrivacy").textContent = t.linkFooterPrivacy;
            document.getElementById("linkFooterEula").textContent = t.linkFooterEula;
            document.getElementById("pricingTitle").textContent = t.pricingTitle;
            document.getElementById("pricingSubtitle").textContent = t.pricingSubtitle;
            document.getElementById("privacyCtaTitle").textContent = t.privacyCtaTitle;
            document.getElementById("privacyCtaDesc").textContent = t.privacyCtaDesc;

            // Update Features
            const featureCards = document.querySelectorAll("#featuresSection .feature-card");
            t.features.forEach((feat, index) => {
                if (featureCards[index]) {
                    featureCards[index].querySelector(".f-title").textContent = feat.title;
                    featureCards[index].querySelector(".f-desc").textContent = feat.desc;
                }
            });

            // Update Pricing
            document.getElementById("p1Name").textContent = t.p1Name;
            document.getElementById("p1Price").textContent = t.p1Price;
            updateListItems("p1Features", t.p1Features);

            document.getElementById("p2Name").textContent = t.p2Name;
            document.getElementById("p2Price").textContent = t.p2Price;
            updateListItems("p2Features", t.p2Features);

            document.getElementById("p3Name").textContent = t.p3Name;
            document.getElementById("p3Price").textContent = t.p3Price;
            updateListItems("p3Features", t.p3Features);
        }

        function updateListItems(elementId, itemsArray) {
            const list = document.getElementById(elementId);
            list.innerHTML = "";
            itemsArray.forEach(item => {
                const li = document.createElement("li");
                li.textContent = item;
                list.appendChild(li);
            });
        }

        // Initialize default
        switchLanguage("en");
    </script>
