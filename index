        :root {
            --bg-primary: #0a0e17;
            --bg-secondary: #111827;
            --accent-sage: #84a98c;
            --accent-sage-glow: rgba(132, 169, 140, 0.15);
            --text-primary: #f3f4f6;
            --text-secondary: #9ca3af;
            --gradient-accent: linear-gradient(135deg, #a78bfa, #6366f1);
            --card-border: rgba(255, 255, 255, 0.08);
            --card-bg: rgba(255, 255, 255, 0.03);
            --card-bg-hover: rgba(255, 255, 255, 0.06);
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Outfit', sans-serif;
            background-color: var(--bg-primary);
            color: var(--text-primary);
            line-height: 1.6;
            overflow-x: hidden;
        }

        header {
            max-width: 1200px;
            margin: 0 auto;
            padding: 24px 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid var(--card-border);
        }

        .logo {
            font-size: 1.5rem;
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: 10px;
            color: #fff;
            text-decoration: none;
        }

        .logo span {
            color: var(--accent-sage);
        }

        .lang-select {
            background-color: var(--card-bg);
            border: 1px solid var(--card-border);
            color: var(--text-primary);
            padding: 8px 12px;
            border-radius: 8px;
            font-size: 0.9rem;
            outline: none;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .lang-select:hover {
            border-color: var(--accent-sage);
            background-color: var(--card-bg-hover);
        }

        .hero {
            max-width: 1000px;
            margin: 80px auto;
            padding: 0 20px;
            text-align: center;
        }

        .hero h1 {
            font-size: 3.5rem;
            font-weight: 700;
            line-height: 1.2;
            margin-bottom: 24px;
            background: linear-gradient(135deg, #ffffff 40%, var(--accent-sage));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .hero p {
            font-size: 1.25rem;
            color: var(--text-secondary);
            max-width: 700px;
            margin: 0 auto 40px auto;
        }

        .cta-buttons {
            display: flex;
            gap: 16px;
            justify-content: center;
            flex-wrap: wrap;
        }

        .btn {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 14px 28px;
            border-radius: 12px;
            font-weight: 600;
            text-decoration: none;
            transition: all 0.3s ease;
            cursor: pointer;
        }

        .btn-primary {
            background: var(--gradient-accent);
            color: #fff;
            box-shadow: 0 4px 20px rgba(99, 102, 241, 0.4);
        }

        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 24px rgba(99, 102, 241, 0.6);
        }

        .btn-secondary {
            background-color: var(--card-bg);
            border: 1px solid var(--card-border);
            color: var(--text-primary);
        }

        .btn-secondary:hover {
            background-color: var(--card-bg-hover);
            border-color: var(--text-secondary);
            transform: translateY(-2px);
        }

        .features {
            max-width: 1200px;
            margin: 100px auto;
            padding: 0 20px;
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 30px;
        }

        .feature-card {
            background: var(--card-bg);
            border: 1px solid var(--card-border);
            border-radius: 20px;
            padding: 32px;
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
        }

        .feature-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: radial-gradient(circle at top left, var(--accent-sage-glow), transparent 70%);
            pointer-events: none;
        }

        .feature-card:hover {
            transform: translateY(-5px);
            border-color: rgba(132, 169, 140, 0.3);
            background: var(--card-bg-hover);
        }

        .feature-icon {
            font-size: 2.5rem;
            margin-bottom: 20px;
            display: inline-block;
        }

        .feature-card h3 {
            font-size: 1.4rem;
            font-weight: 600;
            margin-bottom: 12px;
            color: #fff;
        }

        .feature-card p {
            color: var(--text-secondary);
            font-size: 0.95rem;
            line-height: 1.6;
        }

        .pricing {
            max-width: 1000px;
            margin: 120px auto;
            padding: 0 20px;
            text-align: center;
        }

        .pricing h2 {
            font-size: 2.5rem;
            margin-bottom: 16px;
        }

        .pricing-subtitle {
            color: var(--text-secondary);
            margin-bottom: 60px;
            font-size: 1.1rem;
        }

        .pricing-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 30px;
            align-items: stretch;
        }

        .pricing-card {
            background: var(--card-bg);
            border: 1px solid var(--card-border);
            border-radius: 24px;
            padding: 40px 32px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            transition: all 0.3s ease;
            position: relative;
        }

        .pricing-card.premium {
            border-color: rgba(99, 102, 241, 0.4);
            background: linear-gradient(180deg, rgba(255,255,255,0.04) 0%, rgba(99, 102, 241, 0.02) 100%);
        }

        .pricing-card.premium::after {
            content: 'POPULAR';
            position: absolute;
            top: -12px;
            left: 50%;
            transform: translateX(-50%);
            background: var(--gradient-accent);
            color: #fff;
            font-size: 0.75rem;
            font-weight: 700;
            padding: 4px 16px;
            border-radius: 20px;
            letter-spacing: 1px;
        }

        .pricing-card:hover {
            transform: scale(1.02);
            border-color: rgba(255,255,255,0.2);
        }

        .pricing-card.premium:hover {
            border-color: rgba(99, 102, 241, 0.8);
        }

        .price-name {
            font-size: 1.25rem;
            color: var(--text-secondary);
            margin-bottom: 16px;
        }

        .price-amount {
            font-size: 2.75rem;
            font-weight: 700;
            color: #fff;
            margin-bottom: 24px;
        }

        .price-features {
            list-style: none;
            text-align: left;
            margin-bottom: 40px;
        }

        .price-features li {
            font-size: 0.95rem;
            color: var(--text-secondary);
            margin-bottom: 12px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .price-features li::before {
            content: '✓';
            color: var(--accent-sage);
            font-weight: bold;
        }

        .privacy-cta {
            max-width: 800px;
            margin: 100px auto;
            padding: 48px;
            background: radial-gradient(circle at center, rgba(132, 169, 140, 0.08), transparent 70%);
            border: 1px solid var(--card-border);
            border-radius: 24px;
            text-align: center;
        }

        .privacy-cta h3 {
            font-size: 1.75rem;
            margin-bottom: 12px;
        }

        .privacy-cta p {
            color: var(--text-secondary);
            margin-bottom: 24px;
            font-size: 1rem;
        }

        footer {
            max-width: 1200px;
            margin: 0 auto;
            padding: 60px 20px 40px 20px;
            border-top: 1px solid var(--card-border);
            text-align: center;
            font-size: 0.9rem;
            color: var(--text-secondary);
        }

        .footer-links {
            display: flex;
            gap: 20px;
            justify-content: center;
            margin-bottom: 24px;
        }

        .footer-links a {
            color: var(--text-secondary);
            text-decoration: none;
            transition: color 0.3s ease;
        }

        .footer-links a:hover {
            color: var(--accent-sage);
        }

        @media (max-width: 768px) {
            .hero h1 {
                font-size: 2.5rem;
            }
            .hero p {
                font-size: 1.1rem;
            }
            .features {
                grid-template-columns: 1fr;
            }
            .pricing-grid {
                grid-template-columns: 1fr;
                gap: 40px;
            }
        }
    </style>
</head>
